# WikiMind Environment Configuration
# Copy this file to .env and fill in your actual values.
# All variables below are read by backend/config.py via Pydantic BaseSettings.

# ---------------------------------------------------------------------------
# LLM Provider (OpenRouter — used for generation and grading)
# ---------------------------------------------------------------------------
# REQUIRED for LLM generation. Get a key from https://openrouter.ai/
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="gpt-oss-20b:free"
LLM_BASE_URL="https://openrouter.ai/api/v1"

# ---------------------------------------------------------------------------
# Embedding Model (local via FastEmbed — no API key needed)
# ---------------------------------------------------------------------------
# Options:
#   "BAAI/bge-small-en-v1.5" (384 dims, free, local)
#   "BAAI/bge-base-en-v1.5"  (768 dims, free, local)
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Qdrant Vector Database
# ---------------------------------------------------------------------------
# QDRANT_MODE: "local" = embedded mode (no Docker), "remote" = server mode
# For local mode, data is stored at QDRANT_LOCAL_PATH.
# For remote mode, QDRANT_URL and optionally QDRANT_API_KEY are used.
QDRANT_MODE="local"
QDRANT_LOCAL_PATH="data/qdrant_storage"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="wikimind_hybrid"

# Article-level index for Two-Stage Local Retrieval
ARTICLE_COLLECTION="wikimind_articles"
ARTICLE_SEARCH_TOP_K=3

# ---------------------------------------------------------------------------
# Redis Stack (Semantic Cache + Knowledge Graph)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_STATIC=86400
CACHE_TTL_DYNAMIC=3600

# ---------------------------------------------------------------------------
# Langfuse Observability (OPTIONAL)
# ---------------------------------------------------------------------------
# Leave empty to disable Langfuse tracing.
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# ---------------------------------------------------------------------------
# Tavily Web Search (OPTIONAL — no longer required for core operation)
# The local article index (wikimind_articles) replaces Tavily for article
# discovery. Set this only if you want a web-search fallback.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=""

# ---------------------------------------------------------------------------
# Retrieval Parameters
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=10
RRF_K=20
RERANKER_TOP_K=5
RERANKER_MODEL="ms-marco-MiniLM-L-12-v2"

# ---------------------------------------------------------------------------
# Agent Graph Parameters
# ---------------------------------------------------------------------------
MAX_GRAPH_STEPS=12
MAX_GENERATION_DOCS=5
TAVILY_MAX_RESULTS=3
MAX_HALLUCINATION_RETRIES=1
MAX_ANSWER_RETRIES=1

# ---------------------------------------------------------------------------
# Application Server
# ---------------------------------------------------------------------------
APP_HOST="0.0.0.0"
APP_PORT=8000
LOG_LEVEL="INFO"
API_KEY=""
RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Wikipedia Sync
# ---------------------------------------------------------------------------
WIKI_STREAM_URL="https://stream.wikimedia.org/v2/stream/recentchange"
WIKI_RECONCILE_INTERVAL_HOURS=24
